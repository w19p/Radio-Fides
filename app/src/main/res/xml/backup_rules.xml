<full-backup-content>

    <!--
        Excluimos la carpeta de grabaciones del backup automático.
        Los archivos MP3 pueden ser muy pesados y no tiene sentido
        respaldarlos en Google Drive del usuario sin su conocimiento.
        Si el usuario desinstala la app, las grabaciones se pierden
        intencionalmente — son capturas temporales de radio en vivo.
    -->
    <exclude domain="file" path="Grabaciones radio fides/" />

</full-backup-content>